venv/
.python-version
.uv-cache/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ---------- Data / experiment outputs ----------
# 실험 데이터·산출물은 원칙적으로 커밋하지 않음 (필요하면 !로 예외 지정)
data/raw/
data/processed/
outputs/
*.parquet
*.jsonl
*.csv
*.xlsx
*.h5
*.pkl

# ---------- LaTeX ----------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.synctex(busy)
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bcf
*.run.xml
*.xdv

# ---------- Secrets ----------
.env
.env.*
*.pem
secrets/
# 공공데이터포털(data.go.kr) 등 API 키가 든 설정 파일
config.local.*

# ---------- OS / editors ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# ---------- 실험 산출물 예외 ----------
# 재현 가능한 벤치마크로 공개해야 하는 산출물은 커밋한다.
!experiments/results/*.parquet
!experiments/results/*.csv
!experiments/figures/*
# 스냅샷은 metadata.json만 커밋하고 원본 바이트는 별도 공개한다.
experiments/snapshots/*/*/source/
!experiments/snapshots/**/metadata.json
# 빌드된 데이터셋 artifact는 크기 때문에 커밋하지 않는다 (Hugging Face로 공개)
experiments/datasets/**
!experiments/datasets/.gitkeep
